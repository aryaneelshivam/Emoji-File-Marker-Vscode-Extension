{
  "name": "emoji-file-markers",
  "displayName": "Emoji File Markers",
  "description": "Mark and tag files with emojis in the VS Code file explorer",
  "version": "0.2.1",
  "icon": "emojilogo.png",
  "publisher": "AryaneelShivam",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryaneelshivam/Emoji-File-Marker-Vscode-Extension.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aryaneelshivam/Emoji-File-Marker-Vscode-Extension/issues"
  },
  "homepage": "https://github.com/aryaneelshivam/Emoji-File-Marker-Vscode-Extension#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "emoji",
    "file",
    "markers",
    "tags",
    "organization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "emojiFileMarkers.addEmoji",
        "title": "Add Emoji Marker"
      },
      {
        "command": "emojiFileMarkers.removeEmoji",
        "title": "Remove Emoji Marker"
      },
      {
        "command": "emojiFileMarkers.clearAll",
        "title": "Clear All Emoji Markers"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "emojiFileMarkers.addEmoji",
          "when": "resourceScheme == file",
          "group": "2_workspace@1"
        },
        {
          "command": "emojiFileMarkers.removeEmoji",
          "when": "resourceScheme == file",
          "group": "2_workspace@2"
        }
      ],
      "commandPalette": [
        {
          "command": "emojiFileMarkers.addEmoji",
          "when": "resourceScheme == file"
        },
        {
          "command": "emojiFileMarkers.removeEmoji",
          "when": "resourceScheme == file"
        },
        {
          "command": "emojiFileMarkers.clearAll",
          "when": "workspaceFolderCount != 0"
        }
      ]
    },
    "configuration": {
      "title": "Emoji File Markers",
      "properties": {
        "emojiFileMarkers.showInheritedMarkers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show an emoji badge on files and folders inside a marked folder. When off, only the folder you marked gets a badge."
        },
        "emojiFileMarkers.inheritedMarkerPrefix": {
          "type": "string",
          "default": "·",
          "markdownDescription": "Character placed before an inherited emoji to tell it apart from one set directly on the item, for example `·🔥` vs `🔥`. Set to an empty string to show the bare emoji. Only the first character is used — VS Code badges hold at most two."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@vscode/vsce": "^3.7.1"
  }
}
